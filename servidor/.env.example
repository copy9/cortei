# Cortei: copie este arquivo para .env e preencha. Nunca envie o .env ao GitHub.
# cp .env.example .env && nano .env

# Seu domínio, sem https:// e sem www (usado pelo Caddy para emitir o HTTPS).
DOMAIN=seudominio.com.br

# Conta de administrador criada na primeira vez que o servidor sobe.
# Use uma senha forte, de 12 caracteres ou mais.
ADMIN_EMAIL=voce@seudominio.com.br
ADMIN_PASSWORD=troque-esta-senha-agora

# E-mail de contato que aparece no rodapé do site.
CONTACT_EMAIL=contato@seudominio.com.br

# Deixe 1 em produção (o cookie de sessão só trafega por HTTPS).
# Use 0 apenas para testar em http://localhost.
COOKIE_SECURE=1

# Opcionais: só mude se souber o que está fazendo.
# PORT=3000
# DATA_DIR=/app/data
# PUBLIC_DIR=/app/public
